# Per-user settings for agent-harness. install.sh writes harness.env (gitignored) from this file,
# asking for the values or taking them as KEY=VALUE arguments. Absolute paths, no spaces.
# Edit harness.env, then re-run install.sh.

# Folder that holds your projects.
PROJECTS_DIR="$HOME/Projects"

# Your private profile: ABOUT.md, memory/, knowledge/, secrets.md, your own skills, module data.
PROFILE_DIR="$PROJECTS_DIR/agent-profile"

# Git URL of the profile's private GitHub repo. Empty = local only, no sync.
PROFILE_REMOTE=""

# Your GitHub handle.
GH_USER=""

# launchd labels become com.<prefix>.harness-sync and so on. Lowercase letters, digits, dashes.
LABEL_PREFIX=""

# Optional modules, space separated: telegram browser firstmate hammerspoon cron. Empty = core only.
MODULES=""

# Working folders whose Claude Code auto-memory is linked to the profile's memory/.
MEMORY_DIRS="$HOME"

# Seconds between syncs of the profile repo.
SYNC_INTERVAL=7200

# 1 = sync.sh also commits and pushes changes to tracked framework files (never new files). 0 = pull only.
FRAMEWORK_PUSH=0
# Sharing changes both ways (CONTRIBUTING.md): the shared repo's remote, your fork's remote (leave as is
# if you own the shared repo and have no fork), and the branch this checkout runs: upstream plus your
# open PRs, rebuilt by scripts/upstream.sh sync.
UPSTREAM_REMOTE=origin
FORK_REMOTE=fork
LOCAL_BRANCH=local

# browser module: debug port of Claude Chrome, and extra browsers as id:port
# (e.g. "personal:9223" adds ~/.chrome-personal and a chrome-personal command).
BROWSER_PORT=9222
BROWSER_EXTRA=""

# telegram module: the bot session's working folder, and the morning brief time (HH:MM, local).
TELEGRAM_WORKDIR="$PROJECTS_DIR/claude-telegram"
TELEGRAM_BRIEF_TIME="08:30"

# firstmate module: repo to clone (upstream or your fork), optional upstream remote for a fork,
# where it lives, its tmux session, 1 to give it its own Telegram bot, and 1 to start it at login.
FIRSTMATE_REPO="https://github.com/kunchenguid/firstmate.git"
FIRSTMATE_UPSTREAM=""
FIRSTMATE_DIR="$PROJECTS_DIR/firstmate"
FIRSTMATE_SESSION="firstmate"
FIRSTMATE_TELEGRAM=0
FIRSTMATE_AUTOSTART=1

# Background `claude -p` jobs (session summaries, morning brief): 1 = drop ANTHROPIC_API_KEY so they use
# your claude.ai subscription login. Leave 0 if you only sign in with an API key.
CLAUDE_P_IGNORE_API_KEY=0
