<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__FIRSTMATE_LABEL__</string>
  <!-- At login: start firstmate's tmux session if it isn't running. tmux keeps it alive after that. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>__HARNESS_DIR__/modules/firstmate/install.sh --start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HARNESS_DIR__/logs/firstmate-autostart.log</string>
  <key>StandardErrorPath</key><string>__HARNESS_DIR__/logs/firstmate-autostart.log</string>
</dict>
</plist>
