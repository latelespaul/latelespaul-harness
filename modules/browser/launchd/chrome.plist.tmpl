<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__CHROME_LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HARNESS_DIR__/modules/browser/chrome-launch.sh</string>
    <string>__CHROME_ID__</string>
    <string>__CHROME_PORT__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <!-- Restart only after a non-zero exit: chrome-launch.sh exits 0 when it leaves Chrome stopped. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/__CHROME_PROFILE__-logs/chrome.log</string>
  <key>StandardErrorPath</key><string>__HOME__/__CHROME_PROFILE__-logs/chrome.log</string>
</dict>
</plist>
